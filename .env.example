# Server-only Shopify credentials. Do not use NEXT_PUBLIC_ prefixes in production.
SHOPIFY_STORE_DOMAIN=aglory-hair-and-cosmetics.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace_with_your_storefront_access_token
# Used to validate Shopify's HMAC-signed product and collection webhooks.
SHOPIFY_WEBHOOK_SECRET=replace_with_your_webhook_signing_secret
# Required for noindex preview deployments on non-Vercel hosting.
DEPLOYMENT_ENV=production
# Shopify Headless > Customer Account API (public web client + PKCE).
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=replace_with_customer_account_client_id
# Must exactly match the HTTPS callback registered in Shopify.
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=https://www.agloryhairandcosmetics.co.uk/auth/callback
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_REDIRECT_URI=https://www.agloryhairandcosmetics.co.uk/
